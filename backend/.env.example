# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (server only: the service role key must NEVER reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (optional: without it /api/dispatch/run falls back to rule-based assignment)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Passcode required to use the app. Server only: never put it in the frontend or a VITE_ variable.
APP_PASSCODE=

# Optional
# ALLOWED_ORIGIN=https://your-frontend.vercel.app   # CORS origin for the API (default *)
# ROUTING_PROVIDER=mock                            # mock | mapbox | google
# MAPBOX_TOKEN=
# GOOGLE_MAPS_API_KEY=
# DELAY_THRESHOLD_MIN=10
# SIM_SPEED_MULTIPLIER=1
